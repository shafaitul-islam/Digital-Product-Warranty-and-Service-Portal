@model DWS.Web.UI.Models.ViewModels.ForgotPasswordViewModel

@{
    // Sets the browser page title.
    ViewData["Title"] = "Forgot Password";
}

<!-- Provides styling for the password recovery page. -->
<style>
    /* Centers the password recovery card. */
    .recovery-page {
        min-height: calc(100vh - 140px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 45px 15px;
        background: #f3f6fc;
    }

    /* Main recovery card. */
    .recovery-card {
        width: 100%;
        max-width: 470px;
        padding: 42px;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid #e5eaf2;
        box-shadow: 0 15px 45px rgba(20, 40, 80, 0.09);
    }

    /* Recovery icon container. */
    .recovery-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 22px;
        border-radius: 18px;
        background: #eaf1ff;
        color: #285fc0;
        font-size: 29px;
    }

    .recovery-title {
        color: #172b4d;
        font-size: 27px;
        font-weight: 750;
        text-align: center;
        margin-bottom: 12px;
    }

    .recovery-description {
        color: #7b879b;
        font-size: 14px;
        line-height: 1.7;
        text-align: center;
        margin-bottom: 28px;
    }

    .recovery-label {
        color: #263650;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 9px;
    }

    .recovery-input {
        min-height: 49px;
        border: 1px solid #dce3ee;
        border-radius: 10px;
        padding: 12px 14px;
    }

        .recovery-input:focus {
            border-color: #3569d4;
            box-shadow: 0 0 0 4px rgba(53, 105, 212, 0.10);
        }

    .recovery-button {
        min-height: 50px;
        width: 100%;
        border: none;
        border-radius: 10px;
        color: #ffffff;
        background: linear-gradient(100deg, #2456b5, #3978e8);
        font-weight: 650;
        margin-top: 10px;
        transition: all 0.2s ease;
    }

        .recovery-button:hover {
            background: linear-gradient(100deg, #194595, #2865d0);
            transform: translateY(-1px);
        }

    .recovery-back {
        display: block;
        text-align: center;
        margin-top: 24px;
        color: #285fc0;
        font-size: 14px;
        font-weight: 650;
        text-decoration: none;
    }

        .recovery-back:hover {
            text-decoration: underline;
        }

    .recovery-theme-control {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 18px;
    }

    /* Applies dark-theme colors to the recovery page. */
    html[data-theme="dark"] .recovery-page {
        background: var(--page-background, #111827);
    }

    html[data-theme="dark"] .recovery-card {
        background: var(--surface-background, #1f2937);
        border-color: var(--border-color, #374151);
    }

    html[data-theme="dark"] .recovery-title,
    html[data-theme="dark"] .recovery-label {
        color: var(--text-primary, #f9fafb);
    }

    html[data-theme="dark"] .recovery-description {
        color: var(--text-secondary, #cbd5e1);
    }

    html[data-theme="dark"] .recovery-icon {
        background: #263d66;
        color: #93baff;
    }

    html[data-theme="dark"] .recovery-input {
        background: var(--input-background, #111827);
        color: var(--text-primary, #f9fafb);
        border-color: var(--input-border, #4b5563);
    }

        html[data-theme="dark"] .recovery-input::placeholder {
            color: #9ca3af;
        }

    html[data-theme="dark"] .recovery-back {
        color: #93baff;
    }
</style>

<!-- Main password recovery page. -->
<div class="recovery-page">

    <div class="recovery-card">

        <!-- Provides the global light and dark theme toggle. -->
        <div class="recovery-theme-control">
            <button type="button"
                    class="btn btn-outline-primary"
                    data-theme-toggle
                    aria-label="Switch to dark mode"
                    aria-pressed="false">
                <span data-theme-icon>🌙</span>
                <span data-theme-label>Dark Mode</span>
            </button>
        </div>

        <!-- Password recovery icon. -->
        <div class="recovery-icon">
            🔐
        </div>

        <!-- Page heading. -->
        <h1 class="recovery-title">Forgot Password?</h1>

        <p class="recovery-description">
            Don't worry! Enter your registered email address.
            We will send you a secure password reset link.
        </p>

        <!-- Submits the recovery request to AccountController. -->
        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post">

            <!-- Displays validation errors. -->
            <div asp-validation-summary="ModelOnly"
                 class="text-danger small mb-3">
            </div>

            <!-- Registered email address field. -->
            <div class="mb-3">
                <label asp-for="Email" class="recovery-label">
                    Email Address
                </label>

                <input asp-for="Email"
                       type="email"
                       class="form-control recovery-input"
                       placeholder="example@email.com"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="text-danger small">
                </span>
            </div>

            <!-- Sends the password recovery request. -->
            <button type="submit" class="recovery-button">
                Send Reset Link →
            </button>

        </form>

        <!-- Returns the customer to the login page. -->
        <a asp-controller="Account"
           asp-action="Login"
           class="recovery-back">
            ← Back to Sign In
        </a>

    </div>
</div>

@section Scripts {
    <!-- Loads client-side validation scripts. -->
    <partial name="_ValidationScriptsPartial" />
}
