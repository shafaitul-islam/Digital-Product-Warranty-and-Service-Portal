@{
    // Sets the browser page title.
    ViewData["Title"] = "Check Your Email";
}

<!-- Main password recovery confirmation container. -->
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-6">

            <!-- Confirmation card. -->
            <div class="card border-0 shadow-lg rounded-4 text-center p-4 p-md-5">

                <!-- Success icon. -->
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle"
                         style="width: 85px; height: 85px; background: #e8f7ef; color: #198754; font-size: 42px;">
                        ✓
                    </div>
                </div>

                <!-- Confirmation heading. -->
                <h1 class="h3 fw-bold mb-3">
                    Check Your Email
                </h1>

                <!-- Explains the password recovery result without revealing account existence. -->
                <p class="text-secondary mb-3">
                    If an account with the email address you entered exists,
                    a password reset link has been sent.
                </p>

                <!-- Provides instructions for the next step. -->
                <p class="text-secondary small mb-4">
                    Please check your inbox and follow the instructions
                    in the email to reset your password.
                    If you cannot find it, check your spam or junk folder.
                </p>

                <!-- Returns the user to the login page. -->
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-primary rounded-3 py-2 px-4 fw-semibold">
                    Back to Sign In
                </a>

                <!-- Security reminder. -->
                <div class="border-top mt-4 pt-3">
                    <small class="text-secondary">
                        🔒 Your account security is important to us.
                    </small>
                </div>

            </div>
        </div>
    </div>
</div>
