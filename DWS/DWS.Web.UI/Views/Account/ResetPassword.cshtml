@model DWS.Web.UI.Models.ViewModels.ResetPasswordViewModel

@{
    // Sets the browser page title.
    ViewData["Title"] = "Reset Password";
}

<style>
    /* Main password reset page background. */
    .reset-page {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
    }

    /* Password reset card styling. */
    .reset-card {
        width: 100%;
        max-width: 480px;
        padding: 38px;
        border: 1px solid var(--bs-border-color);
        border-radius: 20px;
        background: var(--bs-body-bg);
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
    }

    /* Icon displayed above the form. */
    .reset-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #e8f0ff;
        color: #0d6efd;
        font-size: 28px;
    }

    /* Form input styling. */
    .reset-card .form-control {
        min-height: 48px;
        border-radius: 10px;
    }

    /* Password visibility button. */
    .password-toggle {
        border-radius: 0 10px 10px 0;
    }

    /* Dark theme card styling. */
    [data-theme="dark"] .reset-card {
        background: #1e293b;
        border-color: #334155;
        color: #f1f5f9;
    }

        /* Dark theme input styling. */
        [data-theme="dark"] .reset-card .form-control {
            background: #0f172a;
            border-color: #475569;
            color: #f8fafc;
        }

            /* Dark theme placeholder styling. */
            [data-theme="dark"] .reset-card .form-control::placeholder {
                color: #94a3b8;
            }

    /* Dark theme icon styling. */
    [data-theme="dark"] .reset-icon {
        background: #263b60;
        color: #93c5fd;
    }

    /* Responsive spacing for smaller screens. */
    @@media (max-width: 576px) {
        .reset-card {
            padding: 25px 20px;
        }
    }
</style>

<div class="reset-page">
    <div class="reset-card">

        <!-- Displays the password reset icon. -->
        <div class="reset-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

        <div class="text-center mb-4">
            <h2 class="fw-bold mb-2">Create New Password</h2>
            <p class="text-secondary">
                Enter your new password below to secure your account.
            </p>
        </div>

        <!-- Sends the email, token, and new password to the controller. -->
        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post">

            <!-- Preserves the email address from the reset link. -->
            <input asp-for="Email" type="hidden" />

            <!-- Preserves the password reset token securely in the form. -->
            <input asp-for="Token" type="hidden" />

            <!-- Displays model-level validation errors. -->
            <div asp-validation-summary="ModelOnly"
                 class="text-danger small mb-3">
            </div>

            <!-- New password field. -->
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label fw-semibold">
                    New Password
                </label>

                <div class="input-group">
                    <input asp-for="NewPassword"
                           type="password"
                           class="form-control"
                           id="newPassword"
                           placeholder="Enter new password"
                           autocomplete="new-password" />

                    <!-- Toggles password visibility. -->
                    <button class="btn btn-outline-secondary password-toggle"
                            type="button"
                            onclick="togglePassword('newPassword', 'newPasswordIcon')"
                            aria-label="Show or hide new password">
                        <i class="bi bi-eye" id="newPasswordIcon"></i>
                    </button>
                </div>

                <span asp-validation-for="NewPassword"
                      class="text-danger small">
                </span>
            </div>

            <!-- Confirm password field. -->
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                    Confirm New Password
                </label>

                <div class="input-group">
                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control"
                           id="confirmPassword"
                           placeholder="Confirm new password"
                           autocomplete="new-password" />

                    <!-- Toggles confirmation password visibility. -->
                    <button class="btn btn-outline-secondary password-toggle"
                            type="button"
                            onclick="togglePassword('confirmPassword', 'confirmPasswordIcon')"
                            aria-label="Show or hide confirm password">
                        <i class="bi bi-eye" id="confirmPasswordIcon"></i>
                    </button>
                </div>

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger small">
                </span>
            </div>

            <!-- Submits the new password to AccountController. -->
            <button type="submit"
                    class="btn btn-primary w-100 py-3 rounded-3 fw-semibold">
                Reset Password
            </button>

            <!-- Returns the user to the login page. -->
            <div class="text-center mt-4">
                <a asp-controller="Account"
                   asp-action="Login"
                   class="text-decoration-none fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Sign In
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <!-- Loads client-side validation scripts. -->
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Shows or hides the password in the selected input field.
        function togglePassword(inputId, iconId) {
            const passwordInput = document.getElementById(inputId);
            const passwordIcon = document.getElementById(iconId);

            // Switches between password and text input types.
            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                passwordIcon.classList.remove("bi-eye");
                passwordIcon.classList.add("bi-eye-slash");
            } else {
                passwordInput.type = "password";
                passwordIcon.classList.remove("bi-eye-slash");
                passwordIcon.classList.add("bi-eye");
            }
        }
    </script>
}
