@{
    // Sets the browser page title.
    ViewData["Title"] = "Password Reset Successful";
}

<style>
    /* Centers the confirmation card on the page. */
    .reset-success-page {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
    }

    /* Main confirmation card styling. */
    .reset-success-card {
        width: 100%;
        max-width: 480px;
        padding: 40px;
        text-align: center;
        background: var(--bs-body-bg);
        color: var(--bs-body-color);
        border: 1px solid var(--bs-border-color);
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
    }

    /* Success icon styling. */
    .success-icon {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 22px;
        border-radius: 50%;
        background: #e8f7ef;
        color: #198754;
        font-size: 38px;
    }

    /* Dark theme card styling. */
    [data-theme="dark"] .reset-success-card {
        background: #1e293b;
        color: #f1f5f9;
        border-color: #334155;
    }

    /* Dark theme success icon styling. */
    [data-theme="dark"] .success-icon {
        background: #173d32;
        color: #6ee7b7;
    }

    /* Responsive card spacing. */
    @@media (max-width: 576px) {
        .reset-success-card {
            padding: 28px 20px;
        }
    }
</style>

<div class="reset-success-page">
    <div class="reset-success-card">

        <!-- Displays the password reset success icon. -->
        <div class="success-icon">
            <i class="bi bi-check-lg"></i>
        </div>

        <h2 class="fw-bold mb-3">Password Reset Successful!</h2>

        <p class="text-secondary mb-3">
            Your password has been changed successfully.
        </p>

        <p class="text-secondary small mb-4">
            You can now sign in to your account using your new password.
            Keep your password safe and do not share it with anyone.
        </p>

        <!-- Redirects the user to the Login page. -->
        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-primary w-100 py-3 rounded-3 fw-semibold">
            <i class="bi bi-box-arrow-in-right me-2"></i>
            Sign In to Your Account
        </a>

        <!-- Displays a security reminder. -->
        <div class="border-top mt-4 pt-3">
            <small class="text-secondary">
                <i class="bi bi-shield-check me-1"></i>
                Your account security matters to us.
            </small>
        </div>

    </div>
</div>
