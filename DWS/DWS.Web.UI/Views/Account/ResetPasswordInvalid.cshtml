@{
    // Sets the browser page title.
    ViewData["Title"] = "Invalid Reset Link";
}

<style>
    /* Centers the error card on the page. */
    .invalid-page {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
    }

    /* Main error card styling. */
    .invalid-card {
        width: 100%;
        max-width: 480px;
        padding: 40px;
        text-align: center;
        background: var(--bs-body-bg);
        color: var(--bs-body-color);
        border: 1px solid var(--bs-border-color);
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
    }

    /* Error icon styling. */
    .invalid-icon {
        width: 75px;
        height: 75px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 22px;
        border-radius: 50%;
        background: #fde8e8;
        color: #dc3545;
        font-size: 34px;
    }

    /* Dark theme card styling. */
    [data-theme="dark"] .invalid-card {
        background: #1e293b;
        color: #f1f5f9;
        border-color: #334155;
    }

    /* Dark theme error icon styling. */
    [data-theme="dark"] .invalid-icon {
        background: #49252b;
        color: #fca5a5;
    }

    /* Responsive card spacing. */
    @@media (max-width: 576px) {
        .invalid-card {
            padding: 28px 20px;
        }
    }
</style>

<div class="invalid-page">
    <div class="invalid-card">

        <!-- Displays the error icon. -->
        <div class="invalid-icon">
            <i class="bi bi-exclamation-triangle"></i>
        </div>

        <h2 class="fw-bold mb-3">Invalid or Expired Link</h2>

        <p class="text-secondary mb-3">
            This password reset link is invalid or has expired.
        </p>

        <p class="text-secondary small mb-4">
            For your account security, please request a new password
            reset link and try again.
        </p>

        <!-- Redirects the user to the Forgot Password page. -->
        <a asp-controller="Account"
           asp-action="ForgotPassword"
           class="btn btn-primary w-100 py-3 rounded-3 fw-semibold">
            Request New Reset Link
        </a>

        <!-- Provides a link back to the Login page. -->
        <div class="mt-3">
            <a asp-controller="Account"
               asp-action="Login"
               class="text-decoration-none fw-semibold">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Sign In
            </a>
        </div>

    </div>
</div>
