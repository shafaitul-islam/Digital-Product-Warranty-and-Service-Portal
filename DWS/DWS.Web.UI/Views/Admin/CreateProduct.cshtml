@model DWS.Web.UI.Models.ViewModels.CreateProductViewModel

@{
    ViewData["Title"] = "Create Product";
    Layout = "_AdminLayout";
}

<style>
    .create-product-container {
        padding: 24px;
    }

    .create-product-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

    .create-product-header h2 {
        font-size: 26px;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 6px;
    }

    .create-product-header p {
        color: #64748b;
        margin: 0;
        font-size: 14px;
    }

    .back-products-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border: 1px solid #dbe2ea;
        border-radius: 8px;
        background: #fff;
        color: #334155;
        text-decoration: none;
        font-weight: 600;
        transition: .2s;
    }

    .back-products-btn:hover {
        background: #f1f5f9;
        color: #1e293b;
    }

    .product-form-card {
        background: #fff;
        border: 1px solid #e5eaf0;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.04);
        overflow: hidden;
    }

    .form-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e9edf3;
        background: #f8fafc;
    }

    .form-card-header h5 {
        margin: 0;
        color: #1e293b;
        font-weight: 700;
        font-size: 17px;
    }

    .form-card-header p {
        margin: 5px 0 0;
        font-size: 13px;
        color: #64748b;
    }

    .product-form-body {
        padding: 26px;
    }

    .form-section-title {
        font-size: 15px;
        font-weight: 700;
        color: #334155;
        margin-bottom: 18px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eef2f6;
    }

    .form-label {
        color: #334155;
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        min-height: 44px;
        border: 1px solid #dbe2ea;
        border-radius: 8px;
        font-size: 14px;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.10);
    }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .field-validation-error {
        font-size: 12px;
        color: #dc2626;
        margin-top: 5px;
    }

    .validation-summary-errors {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 13px;
    }

    .product-status-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px 17px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 10px;
        gap: 12px;
    }

    .product-status-box strong {
        display: block;
        font-size: 14px;
        color: #334155;
    }

    .product-status-box small {
        display: block;
        color: #64748b;
        margin-top: 4px;
    }

    .form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 22px;
        margin-top: 10px;
        border-top: 1px solid #eef2f6;
    }

    .cancel-btn,
    .save-product-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        border: none;
        transition: .2s;
    }

    .cancel-btn {
        background: #f1f5f9;
        color: #475569;
    }

    .cancel-btn:hover {
        background: #e2e8f0;
        color: #1e293b;
    }

    .save-product-btn {
        background: #4f46e5;
        color: #fff;
        cursor: pointer;
    }

    .save-product-btn:hover {
        background: #4338ca;
        color: #fff;
    }

    @@media (max-width: 768px) {
        .create-product-container {
            padding: 15px;
        }

        .product-form-body {
            padding: 18px;
        }

        .create-product-header h2 {
            font-size: 22px;
        }

        .form-footer {
            flex-direction: column-reverse;
        }

        .form-footer a,
        .form-footer button {
            width: 100%;
        }
    }
</style>

<div class="create-product-container">

    <!-- Page Header -->
    <div class="create-product-header">
        <div>
            <h2>Create New Product</h2>
            <p>Add a new product to the warranty portal catalog.</p>
        </div>

        <a asp-controller="Admin"
           asp-action="Products"
           class="back-products-btn">
            <i class="bi bi-arrow-left"></i>
            Back to Products
        </a>
    </div>

    <!-- Product Form Card -->
    <div class="product-form-card">

        <div class="form-card-header">
            <h5><i class="bi bi-box-seam me-2"></i>Product Information</h5>
            <p>Enter the product details below to add it to your catalog.</p>
        </div>

        <div class="product-form-body">

            <form asp-controller="Admin"
                  asp-action="CreateProduct"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors"></div>

                <!-- Basic Information -->
                <h6 class="form-section-title">
                    Basic Information
                </h6>

                <div class="row g-4 mb-4">

                    <!-- Product Name -->
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">
                            Product Name <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter product name" />

                        <span asp-validation-for="Name"
                              class="field-validation-error"></span>
                    </div>

                    <!-- Model Number -->
                    <div class="col-md-6">
                        <label asp-for="ModelNumber" class="form-label">
                            Model Number <span class="text-danger">*</span>
                        </label>

                        <input asp-for="ModelNumber"
                               class="form-control"
                               placeholder="Enter model number" />

                        <span asp-validation-for="ModelNumber"
                              class="field-validation-error"></span>
                    </div>

                    <!-- Brand -->
                    <div class="col-md-6">
                        <label asp-for="BrandId" class="form-label">
                            Brand <span class="text-danger">*</span>
                        </label>

                        <select asp-for="BrandId"
                                asp-items="Model.Brands"
                                class="form-select">
                            <option value="">Select Brand</option>
                        </select>

                        <span asp-validation-for="BrandId"
                              class="field-validation-error"></span>
                    </div>

                    <!-- Category -->
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label">
                            Category <span class="text-danger">*</span>
                        </label>

                        <select asp-for="CategoryId"
                                asp-items="Model.Categories"
                                class="form-select">
                            <option value="">Select Category</option>
                        </select>

                        <span asp-validation-for="CategoryId"
                              class="field-validation-error"></span>
                    </div>

                    <!-- Price -->
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label">
                            Price (BDT) <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Price"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control"
                               placeholder="Enter product price" />

                        <span asp-validation-for="Price"
                              class="field-validation-error"></span>
                    </div>

                </div>

                <!-- Description -->
                <h6 class="form-section-title">
                    Additional Information
                </h6>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label">
                        Product Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              placeholder="Enter product description..."
                              rows="4"></textarea>

                    <span asp-validation-for="Description"
                          class="field-validation-error"></span>
                </div>

                <!-- Product Status -->
                <h6 class="form-section-title">
                    Product Status
                </h6>

                <div class="product-status-box mb-4">
                    <div>
                        <strong>Active Product</strong>
                        <small>Make this product available in the portal.</small>
                    </div>

                    <div class="form-check form-switch mb-0">
                        <input asp-for="IsActive"
                               class="form-check-input"
                               type="checkbox"
                               role="switch"
                               style="width: 45px; height: 22px; cursor: pointer;" />
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="form-footer">

                    <a asp-controller="Admin"
                       asp-action="Products"
                       class="cancel-btn">
                        <i class="bi bi-x-lg"></i>
                        Cancel
                    </a>

                    <button type="submit" class="save-product-btn">
                        <i class="bi bi-check-lg"></i>
                        Save Product
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>
