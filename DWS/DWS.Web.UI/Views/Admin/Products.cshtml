@model IEnumerable<DWS.Web.UI.Models.ViewModels.AdminProductViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var products = Model?.ToList() ?? new List<DWS.Web.UI.Models.ViewModels.AdminProductViewModel>();

    var totalProducts = products.Count;
    var activeProducts = products.Count(p => p.IsActive);
    var inactiveProducts = totalProducts - activeProducts;
    var totalValue = products.Sum(p => p.Price);
}

<div class="admin-products-page">

    <!-- Page Header -->
    <div class="products-page-header">
        <div class="page-title-wrapper">
            <span class="page-icon">
                <i class="bi bi-box-seam"></i>
            </span>

            <div>
                <h2>Product Management</h2>
                <p>Manage products, catalog information and availability.</p>
            </div>
        </div>

        <div class="page-header-actions">
            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="header-action-btn dashboard-btn">
                <i class="bi bi-arrow-left"></i>
                Dashboard
            </a>

            <a asp-controller="Admin"
               asp-action="CreateProduct"
               class="header-action-btn add-product-btn">
                <i class="bi bi-plus-lg"></i>
                Add New Product
            </a>
        </div>
    </div>

    <!-- Statistics -->
    <div class="products-stats-grid">

        <!-- Total Products -->
        <div class="product-stat-card">
            <div class="product-stat-info">
                <span class="stat-label">Total Products</span>
                <h3>@totalProducts</h3>
                <span class="stat-description">Products in catalog</span>
            </div>

            <div class="product-stat-icon blue">
                <i class="bi bi-boxes"></i>
            </div>
        </div>

        <!-- Active Products -->
        <div class="product-stat-card">
            <div class="product-stat-info">
                <span class="stat-label">Active Products</span>
                <h3>@activeProducts</h3>
                <span class="stat-description">Available products</span>
            </div>

            <div class="product-stat-icon green">
                <i class="bi bi-check-circle"></i>
            </div>
        </div>

        <!-- Inactive Products -->
        <div class="product-stat-card">
            <div class="product-stat-info">
                <span class="stat-label">Inactive Products</span>
                <h3>@inactiveProducts</h3>
                <span class="stat-description">Unavailable products</span>
            </div>

            <div class="product-stat-icon orange">
                <i class="bi bi-pause-circle"></i>
            </div>
        </div>

        <!-- Catalog Value -->
        <div class="product-stat-card">
            <div class="product-stat-info">
                <span class="stat-label">Catalog Value</span>
                <h3>৳@totalValue.ToString("N0")</h3>
                <span class="stat-description">Combined product price</span>
            </div>

            <div class="product-stat-icon purple">
                <i class="bi bi-currency-exchange"></i>
            </div>
        </div>

    </div>

    <!-- Product Catalog -->
    <div class="products-content-card">

        <!-- Catalog Header -->
        <div class="products-card-header">
            <div>
                <h4>Product Catalog</h4>
                <p>View all products registered in the system.</p>
            </div>

            <div class="products-total-badge">
                <i class="bi bi-box-seam"></i>
                @totalProducts Products
            </div>
        </div>

        <!-- Search and Filter -->
        <div class="products-toolbar">

            <div class="products-search-box">
                <i class="bi bi-search"></i>

                <input type="text"
                       id="productSearch"
                       placeholder="Search name, model, brand or category..."
                       autocomplete="off" />
            </div>

            <select id="productStatusFilter" class="product-status-filter">
                <option value="all">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>

        </div>

        <!-- Product Table -->
        <div class="products-table-wrapper">
            <table class="products-table" id="productsTable">

                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Brand</th>
                        <th>Category</th>
                        <th>Model Number</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Created</th>
                    </tr>
                </thead>

                <tbody id="productsTableBody">

                    @if (products.Any())
                    {
                        foreach (var product in products)
                        {
                            <tr data-status="@(product.IsActive ? "active" : "inactive")">

                                <!-- Product -->
                                <td>
                                    <div class="product-name-cell">
                                        <div class="product-avatar">
                                            <i class="bi bi-box-seam"></i>
                                        </div>

                                        <div class="product-name-info">
                                            <span class="product-main-name">
                                                @product.Name
                                            </span>

                                            <span class="product-id">
                                                ID: #@product.ProductId
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Brand -->
                                <td>
                                    <span class="product-table-text">
                                        @product.BrandName
                                    </span>
                                </td>

                                <!-- Category -->
                                <td>
                                    <span class="category-chip">
                                        @product.CategoryName
                                    </span>
                                </td>

                                <!-- Model Number -->
                                <td>
                                    <span class="model-number">
                                        @product.ModelNumber
                                    </span>
                                </td>

                                <!-- Price -->
                                <td>
                                    <span class="product-price">
                                        ৳@product.Price.ToString("N2")
                                    </span>
                                </td>

                                <!-- Status -->
                                <td>
                                    @if (product.IsActive)
                                    {
                                        <span class="product-status-badge active">
                                            <span class="status-dot"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="product-status-badge inactive">
                                            <span class="status-dot"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <!-- Created Date -->
                                <td>
                                    <span class="product-date">
                                        @product.CreatedAt.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="empty-product-row">
                            <td colspan="7">
                                <div class="products-empty-state">
                                    <div class="empty-icon">
                                        <i class="bi bi-box-seam"></i>
                                    </div>

                                    <h5>No Products Found</h5>
                                    <p>There are currently no products in your catalog.</p>
                                </div>
                            </td>
                        </tr>
                    }

                    <!-- Search Results Empty State -->
                    <tr id="noSearchResults" style="display: none;">
                        <td colspan="7">
                            <div class="products-empty-state">
                                <div class="empty-icon">
                                    <i class="bi bi-search"></i>
                                </div>

                                <h5>No Matching Products</h5>
                                <p>Try changing your search term or status filter.</p>
                            </div>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>

        <!-- Table Footer -->
        <div class="products-table-footer">
            <span>
                Showing <strong id="visibleProductCount">@totalProducts</strong>
                of <strong>@totalProducts</strong> products
            </span>
        </div>

    </div>

</div>

<style>

    /* Main Container */
    .admin-products-page {
        color: #1e293b;
        padding: 5px;
    }

    /* Page Header */
    .products-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .page-title-wrapper {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .page-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef2ff;
        color: #4f46e5;
        border-radius: 12px;
        font-size: 22px;
        flex-shrink: 0;
    }

    .products-page-header h2 {
        font-size: 26px;
        font-weight: 700;
        margin: 0;
        color: #0f172a;
    }

    .products-page-header p {
        font-size: 13px;
        color: #64748b;
        margin: 5px 0 0;
    }

    /* Header Buttons */
    .page-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 15px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    /* Dashboard Button */
    .dashboard-btn {
        background: #ffffff;
        border: 1px solid #dbe3ee;
        color: #475569;
    }

        .dashboard-btn:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: #1e293b;
        }

    /* Add Product Button */
    .add-product-btn {
        background: #4f46e5;
        border: 1px solid #4f46e5;
        color: #ffffff;
    }

        .add-product-btn:hover {
            background: #4338ca;
            border-color: #4338ca;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(79, 70, 229, 0.20);
        }

    /* Statistics */
    .products-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .product-stat-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        background: #ffffff;
        border: 1px solid #e5eaf1;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 5px rgba(15, 23, 42, 0.03);
    }

    .stat-label {
        display: block;
        color: #64748b;
        font-size: 12px;
        font-weight: 500;
    }

    .product-stat-card h3 {
        font-size: 25px;
        font-weight: 700;
        color: #0f172a;
        margin: 8px 0;
        word-break: break-word;
    }

    .stat-description {
        display: block;
        color: #94a3b8;
        font-size: 11px;
    }

    .product-stat-icon {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        font-size: 20px;
    }

        .product-stat-icon.blue {
            background: #eff6ff;
            color: #2563eb;
        }

        .product-stat-icon.green {
            background: #ecfdf5;
            color: #059669;
        }

        .product-stat-icon.orange {
            background: #fff7ed;
            color: #ea580c;
        }

        .product-stat-icon.purple {
            background: #f5f3ff;
            color: #7c3aed;
        }

    /* Main Catalog Card */
    .products-content-card {
        background: #ffffff;
        border: 1px solid #e5eaf1;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 5px rgba(15, 23, 42, 0.03);
    }

    /* Catalog Header */
    .products-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 20px;
        border-bottom: 1px solid #edf1f6;
    }

        .products-card-header h4 {
            font-size: 16px;
            font-weight: 700;
            color: #0f172a;
            margin: 0;
        }

        .products-card-header p {
            font-size: 12px;
            color: #64748b;
            margin: 5px 0 0;
        }

    .products-total-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 20px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* Search and Filter Toolbar */
    .products-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
    }

    .products-search-box {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        max-width: 420px;
        padding: 10px 12px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        color: #94a3b8;
        transition: 0.2s ease;
    }

        .products-search-box:focus-within {
            border-color: #93c5fd;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.08);
        }

        .products-search-box input {
            width: 100%;
            outline: none;
            border: none;
            background: transparent;
            color: #334155;
            font-size: 13px;
        }

            .products-search-box input::placeholder {
                color: #94a3b8;
            }

    .product-status-filter {
        min-width: 145px;
        padding: 10px 12px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        color: #475569;
        font-size: 12px;
        outline: none;
        cursor: pointer;
    }

        .product-status-filter:focus {
            border-color: #93c5fd;
        }

    /* Table */
    .products-table-wrapper {
        overflow-x: auto;
    }

    .products-table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
        font-size: 12px;
    }

        .products-table thead {
            background: #f8fafc;
        }

        .products-table th {
            padding: 13px 16px;
            text-align: left;
            color: #64748b;
            font-size: 11px;
            font-weight: 600;
            border-top: 1px solid #edf1f6;
            border-bottom: 1px solid #edf1f6;
            white-space: nowrap;
        }

        .products-table td {
            padding: 14px 16px;
            border-bottom: 1px solid #edf1f6;
            vertical-align: middle;
        }

        .products-table tbody tr:not(.empty-product-row):hover {
            background: #fafcff;
        }

    /* Product Identity */
    .product-name-cell {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 180px;
    }

    .product-avatar {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: #3b82f6;
        border-radius: 9px;
        font-size: 17px;
    }

    .product-name-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .product-main-name {
        color: #1e293b;
        font-size: 12px;
        font-weight: 600;
    }

    .product-id {
        color: #94a3b8;
        font-size: 10px;
    }

    .product-table-text {
        color: #475569;
        white-space: nowrap;
    }

    /* Category */
    .category-chip {
        display: inline-block;
        padding: 5px 8px;
        background: #f1f5f9;
        color: #475569;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 500;
        white-space: nowrap;
    }

    /* Model Number */
    .model-number {
        color: #64748b;
        font-family: monospace;
        white-space: nowrap;
    }

    /* Price */
    .product-price {
        color: #0f172a;
        font-weight: 600;
        white-space: nowrap;
    }

    /* Status */
    .product-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
    }

        .product-status-badge.active {
            background: #ecfdf5;
            color: #047857;
        }

        .product-status-badge.inactive {
            background: #f1f5f9;
            color: #64748b;
        }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    /* Date */
    .product-date {
        color: #64748b;
        white-space: nowrap;
    }

    /* Empty State */
    .products-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-height: 230px;
        padding: 30px 15px;
    }

    .empty-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        color: #94a3b8;
        border-radius: 16px;
        font-size: 25px;
        margin-bottom: 15px;
    }

    .products-empty-state h5 {
        color: #334155;
        font-size: 14px;
        font-weight: 600;
        margin: 0 0 6px;
    }

    .products-empty-state p {
        color: #94a3b8;
        font-size: 12px;
        margin: 0;
    }

    /* Table Footer */
    .products-table-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 20px;
        color: #64748b;
        font-size: 11px;
    }

    /* Responsive - Tablet */
    @@media (max-width: 1200px) {
        .products-stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    /* Responsive - Mobile */
    @@media (max-width: 600px) {
        .products-page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .page-header-actions {
            width: 100%;
        }

        .header-action-btn {
            flex: 1;
        }

        .products-stats-grid {
            grid-template-columns: 1fr;
        }

        .products-card-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .products-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .products-search-box {
            max-width: none;
        }

        .product-status-filter {
            width: 100%;
        }
    }

</style>

<script>
    // Product table search and status filtering.
    document.addEventListener('DOMContentLoaded', function () {

        const searchInput = document.getElementById('productSearch');
        const statusFilter = document.getElementById('productStatusFilter');
        const tableBody = document.getElementById('productsTableBody');
        const noResultsRow = document.getElementById('noSearchResults');
        const visibleCount = document.getElementById('visibleProductCount');

        if (!searchInput || !statusFilter || !tableBody) {
            return;
        }

        function filterProducts() {

            const searchTerm = searchInput.value.toLowerCase().trim();
            const selectedStatus = statusFilter.value;
            const rows = tableBody.querySelectorAll('tr[data-status]');

            let visibleProducts = 0;

            rows.forEach(function (row) {

                const rowText = row.textContent.toLowerCase();
                const rowStatus = row.getAttribute('data-status');

                const matchesSearch = rowText.includes(searchTerm);
                const matchesStatus = selectedStatus === 'all' || rowStatus === selectedStatus;

                const shouldShow = matchesSearch && matchesStatus;

                row.style.display = shouldShow ? '' : 'none';

                if (shouldShow) {
                    visibleProducts++;
                }
            });

            if (noResultsRow) {
                noResultsRow.style.display =
                    visibleProducts === 0 && rows.length > 0 ? '' : 'none';
            }

            if (visibleCount) {
                visibleCount.textContent = visibleProducts;
            }
        }

        searchInput.addEventListener('input', filterProducts);
        statusFilter.addEventListener('change', filterProducts);

    });
</script>