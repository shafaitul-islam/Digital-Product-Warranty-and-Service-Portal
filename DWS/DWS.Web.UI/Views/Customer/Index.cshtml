@{
    // Sets the browser page title.
    ViewData["Title"] = "Customer Dashboard";

    // Uses a standalone dashboard page instead of the default site layout.
    Layout = null;

    // Gets the signed-in customer's email or displays a default label.
    var customerEmail = User.Identity?.Name ?? "Customer";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Digital Warranty &amp; Service Portal</title>

    <style>
            /* Removes default browser spacing from the standalone dashboard page. */
            html,
            body {
                margin: 0;
                min-height: 100%;
            }

            /* Applies a consistent background and font to the complete page. */
            body {
                background: #f3f6fc;
                font-family: "Segoe UI", Arial, sans-serif;
            }

            /* Main dashboard theme and page background. */
            .dws-dashboard {
                min-height: 100vh;
                box-sizing: border-box;
                padding: 30px clamp(16px, 3vw, 42px);
                background: #f3f6fc;
                color: #172b4d;
                font-family: "Segoe UI", Arial, sans-serif;
            }

            /* Main layout containing the sidebar and dashboard content. */
            .dws-shell {
                max-width: 1550px;
                margin: 0 auto;
                display: grid;
                grid-template-columns: 250px minmax(0, 1fr);
                gap: 25px;
                align-items: start;
            }

            /* Sidebar design. */
            .dws-sidebar {
                background: #ffffff;
                border: 1px solid #e8edf5;
                border-radius: 20px;
                padding: 25px 17px;
                box-shadow: 0 8px 30px rgba(25, 48, 86, 0.05);
                position: sticky;
                top: 20px;
            }

            .dws-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0 8px 28px;
                text-decoration: none;
                color: #172b4d;
            }

            .dws-brand-logo {
                width: 45px;
                height: 45px;
                border-radius: 13px;
                background: linear-gradient(135deg, #173467, #3478ec);
                display: flex;
                align-items: center;
                justify-content: center;
                color: #ffffff;
                font-size: 17px;
                font-weight: 800;
                letter-spacing: 1px;
            }

            .dws-brand-name {
                font-size: 17px;
                font-weight: 750;
                line-height: 1.2;
            }

            .dws-brand-subtitle {
                display: block;
                color: #8996aa;
                font-size: 10px;
                margin-top: 4px;
                letter-spacing: 1px;
                font-weight: 600;
            }

            .dws-menu-label {
                color: #9aa6b8;
                font-size: 10px;
                font-weight: 750;
                letter-spacing: 1.5px;
                padding: 0 12px;
                margin-bottom: 12px;
            }

            .dws-nav {
                display: flex;
                flex-direction: column;
                gap: 7px;
            }

            .dws-nav-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 13px;
                border-radius: 11px;
                color: #63718a;
                font-size: 13px;
                font-weight: 600;
                text-decoration: none;
                transition: all 0.2s ease;
            }

                .dws-nav-item svg {
                    width: 19px;
                    height: 19px;
                    flex-shrink: 0;
                }

                .dws-nav-item:hover {
                    background: #f0f5ff;
                    color: #2563cf;
                }

                .dws-nav-item.active {
                    background: linear-gradient(110deg, #204b91, #3478ed);
                    color: #ffffff;
                    box-shadow: 0 5px 14px rgba(43, 101, 205, 0.22);
                }

            .dws-sidebar-help {
                margin-top: 35px;
                padding: 16px;
                background: #f3f6fc;
                border-radius: 14px;
            }

                .dws-sidebar-help strong {
                    display: block;
                    font-size: 12px;
                    margin-bottom: 6px;
                }

                .dws-sidebar-help p {
                    font-size: 11px;
                    line-height: 1.6;
                    color: #8491a6;
                    margin: 0;
                }

            /* Main dashboard content. */
            .dws-main {
                min-width: 0;
            }

            /* Top navigation and customer profile. */
            .dws-topbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                background: #ffffff;
                padding: 19px 24px;
                border: 1px solid #e8edf5;
                border-radius: 18px;
                margin-bottom: 23px;
                box-shadow: 0 5px 20px rgba(25, 48, 86, 0.035);
            }

            .dws-eyebrow {
                color: #3478ed;
                font-size: 10px;
                font-weight: 800;
                letter-spacing: 1.6px;
                margin-bottom: 5px;
            }

            .dws-topbar h1 {
                font-size: clamp(21px, 2vw, 27px);
                font-weight: 800;
                margin: 0;
                color: #172b4d;
            }

            .dws-topbar-description {
                font-size: 12px;
                color: #8290a6;
                margin: 5px 0 0;
            }

            .dws-topbar-actions {
                display: flex;
                align-items: center;
                gap: 15px;
            }

            .dws-account {
                display: flex;
                align-items: center;
                gap: 10px;
                min-width: 0;
            }

            .dws-avatar {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                background: #e9f0ff;
                color: #275db2;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 800;
                flex-shrink: 0;
            }

            .dws-account-info strong {
                display: block;
                font-size: 12px;
                color: #253957;
            }

            .dws-account-info small {
                display: block;
                max-width: 180px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                color: #8a96a9;
                font-size: 10px;
            }

            .dws-logout {
                display: flex;
                align-items: center;
                gap: 7px;
                padding: 10px 13px;
                border: 1px solid #e5eaf2;
                background: #ffffff;
                color: #53647e;
                border-radius: 10px;
                font-size: 12px;
                font-weight: 650;
                transition: all 0.2s ease;
            }

                .dws-logout:hover {
                    color: #d14343;
                    border-color: #f2caca;
                    background: #fff7f7;
                }

                .dws-logout svg {
                    width: 16px;
                    height: 16px;
                }

            /* Welcome banner. */
            .dws-hero {
                position: relative;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: space-between;
                min-height: 245px;
                padding: 35px 40px;
                border-radius: 20px;
                color: #ffffff;
                background: linear-gradient(115deg, #142f5c 0%, #214d91 60%, #3477d8 100%);
                margin-bottom: 25px;
                box-shadow: 0 12px 30px rgba(30, 73, 139, 0.17);
            }

                .dws-hero::before {
                    content: "";
                    position: absolute;
                    width: 330px;
                    height: 330px;
                    border: 1px solid rgba(255,255,255,0.12);
                    border-radius: 50%;
                    right: 80px;
                    top: -180px;
                }

                .dws-hero::after {
                    content: "";
                    position: absolute;
                    width: 230px;
                    height: 230px;
                    border: 1px solid rgba(255,255,255,0.10);
                    border-radius: 50%;
                    right: -80px;
                    bottom: -130px;
                }

            .dws-hero-content {
                position: relative;
                z-index: 2;
                max-width: 590px;
            }

            .dws-hero-label {
                display: inline-block;
                padding: 7px 12px;
                background: rgba(255,255,255,0.13);
                border: 1px solid rgba(255,255,255,0.16);
                border-radius: 30px;
                font-size: 9px;
                font-weight: 800;
                letter-spacing: 1.4px;
                margin-bottom: 16px;
            }

            .dws-hero h2 {
                color: #ffffff;
                font-size: clamp(24px, 3vw, 34px);
                line-height: 1.25;
                font-weight: 800;
                margin-bottom: 12px;
            }

            .dws-hero p {
                max-width: 490px;
                color: #d9e6fa;
                font-size: 13px;
                line-height: 1.8;
                margin-bottom: 17px;
            }

            .dws-hero-note {
                display: flex;
                align-items: center;
                gap: 9px;
                color: #edf4ff;
                font-size: 11px;
                font-weight: 600;
            }

            .dws-hero-check {
                width: 22px;
                height: 22px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: rgba(255,255,255,0.18);
                border-radius: 50%;
            }

            /* Decorative warranty illustration. */
            .dws-hero-art {
                position: relative;
                z-index: 2;
                width: 210px;
                height: 175px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .dws-shield {
                width: 125px;
                height: 135px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                background: rgba(255,255,255,0.12);
                border: 1px solid rgba(255,255,255,0.25);
                border-radius: 28px;
                transform: rotate(-5deg);
                box-shadow: 0 15px 35px rgba(0,0,0,0.12);
            }

                .dws-shield svg {
                    width: 54px;
                    height: 54px;
                    margin-bottom: 8px;
                }

                .dws-shield strong {
                    font-size: 12px;
                    letter-spacing: 1px;
                }

            .dws-floating-label {
                position: absolute;
                right: -4px;
                bottom: 12px;
                background: #ffffff;
                color: #214b89;
                padding: 9px 13px;
                border-radius: 10px;
                font-size: 10px;
                font-weight: 800;
                box-shadow: 0 8px 20px rgba(0,0,0,0.12);
            }

            /* Dashboard summary cards. */
            .dws-stats-grid {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 17px;
                margin-bottom: 32px;
            }

            .dws-stat-card {
                background: #ffffff;
                border: 1px solid #e8edf5;
                border-radius: 16px;
                padding: 19px;
                box-shadow: 0 5px 18px rgba(25, 48, 86, 0.035);
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

                .dws-stat-card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 10px 25px rgba(25, 48, 86, 0.08);
                }

            .dws-stat-top {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 17px;
            }

            .dws-stat-icon {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .dws-stat-icon svg {
                    width: 21px;
                    height: 21px;
                }

            .dws-icon-blue {
                color: #3478ed;
                background: #edf3ff;
            }

            .dws-icon-green {
                color: #169b73;
                background: #e8f8f2;
            }

            .dws-icon-orange {
                color: #d88a25;
                background: #fff5e7;
            }

            .dws-icon-purple {
                color: #8862d9;
                background: #f2edff;
            }

            .dws-stat-card h3 {
                color: #172b4d;
                font-size: 26px;
                font-weight: 800;
                margin: 0 0 4px;
            }

            .dws-stat-card p {
                color: #6f7e94;
                font-size: 11px;
                font-weight: 650;
                margin: 0 0 8px;
            }

            .dws-stat-card small {
                color: #a0aabc;
                font-size: 10px;
            }

            /* Section headings. */
            .dws-section-heading {
                display: flex;
                justify-content: space-between;
                align-items: end;
                gap: 15px;
                margin-bottom: 16px;
            }

                .dws-section-heading span {
                    color: #3478ed;
                    font-size: 9px;
                    font-weight: 800;
                    letter-spacing: 1.5px;
                }

                .dws-section-heading h2 {
                    color: #172b4d;
                    font-size: 21px;
                    font-weight: 800;
                    margin: 5px 0 0;
                }

                .dws-section-heading p {
                    color: #8794a8;
                    font-size: 11px;
                    margin: 0;
                }

            /* Quick access feature cards. */
            .dws-feature-grid {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 17px;
                margin-bottom: 27px;
            }

            .dws-feature-card {
                background: #ffffff;
                border: 1px solid #e8edf5;
                border-radius: 16px;
                padding: 20px;
                min-height: 170px;
                scroll-margin-top: 25px;
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

                .dws-feature-card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 10px 25px rgba(25, 48, 86, 0.07);
                }

                .dws-feature-card h3 {
                    color: #233957;
                    font-size: 14px;
                    font-weight: 750;
                    margin: 15px 0 7px;
                }

                .dws-feature-card p {
                    color: #8491a6;
                    font-size: 11px;
                    line-height: 1.7;
                    margin: 0;
                }

            .dws-feature-status {
                display: inline-block;
                margin-top: 13px;
                padding: 5px 9px;
                background: #f0f4fa;
                color: #75849a;
                border-radius: 20px;
                font-size: 9px;
                font-weight: 750;
            }

            /* Recent activity panel. */
            .dws-activity-panel {
                background: #ffffff;
                border: 1px solid #e8edf5;
                border-radius: 17px;
                padding: 22px;
                margin-bottom: 22px;
                scroll-margin-top: 25px;
                box-shadow: 0 5px 18px rgba(25, 48, 86, 0.035);
            }

            .dws-activity-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                margin-bottom: 20px;
            }

                .dws-activity-header h2 {
                    font-size: 17px;
                    font-weight: 800;
                    color: #172b4d;
                    margin: 0;
                }

            .dws-activity-badge {
                background: #edf3ff;
                color: #3478ed;
                padding: 6px 10px;
                border-radius: 20px;
                font-size: 9px;
                font-weight: 750;
            }

            .dws-empty-state {
                text-align: center;
                padding: 28px 15px;
                border: 1px dashed #dce4ef;
                border-radius: 13px;
                background: #fbfcff;
            }

            .dws-empty-icon {
                width: 48px;
                height: 48px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 12px;
                background: #edf3ff;
                color: #3478ed;
                border-radius: 15px;
            }

                .dws-empty-icon svg {
                    width: 23px;
                    height: 23px;
                }

            .dws-empty-state h3 {
                font-size: 13px;
                font-weight: 750;
                color: #334763;
                margin-bottom: 6px;
            }

            .dws-empty-state p {
                max-width: 420px;
                margin: 0 auto;
                color: #8996aa;
                font-size: 11px;
                line-height: 1.7;
            }

            /* Dashboard footer. */
            .dws-dashboard-footer {
                display: flex;
                justify-content: space-between;
                gap: 12px;
                padding: 5px 2px 15px;
                color: #99a4b5;
                font-size: 10px;
            }

            /* Responsive layout for tablets and smaller screens. */
            @@media (max-width: 1100px) {
                .dws-stats-grid,
                .dws-feature-grid {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }
            }

            @@media (max-width: 850px) {
                .dws-shell {
                    grid-template-columns: 1fr;
                }

                .dws-sidebar {
                    position: static;
                    padding: 17px;
                }

                .dws-brand {
                    padding-bottom: 16px;
                }

                .dws-nav {
                    flex-direction: row;
                    overflow-x: auto;
                    padding-bottom: 5px;
                }

                .dws-nav-item {
                    white-space: nowrap;
                }

                .dws-menu-label,
                .dws-sidebar-help {
                    display: none;
                }
            }

            @@media (max-width: 600px) {
                .dws-dashboard {
                    padding: 15px 10px;
                }

                .dws-topbar {
                    align-items: flex-start;
                    flex-direction: column;
                    padding: 18px;
                }

                .dws-topbar-actions {
                    width: 100%;
                    justify-content: space-between;
                }

                .dws-hero {
                    padding: 25px 23px;
                    min-height: auto;
                }

                .dws-hero-art {
                    display: none;
                }

                .dws-stats-grid,
                .dws-feature-grid {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                    gap: 10px;
                }

                .dws-stat-card,
                .dws-feature-card {
                    padding: 14px;
                }

                .dws-section-heading {
                    align-items: flex-start;
                    flex-direction: column;
                }

                .dws-dashboard-footer {
                    flex-direction: column;
                }
            }

            @@media (max-width: 380px) {
                .dws-stats-grid,
                .dws-feature-grid {
                    grid-template-columns: 1fr;
                }
            }
    </style>
</head>
<body>

    <!-- Main customer dashboard layout. -->
    <div class="dws-dashboard">
        <div class="dws-shell">

            <!-- Customer dashboard sidebar. -->
            <aside class="dws-sidebar">

                <!-- Application brand. -->
                <a asp-controller="Customer" asp-action="Index" class="dws-brand">
                    <div class="dws-brand-logo">DWS</div>
                    <div>
                        <div class="dws-brand-name">Warranty Portal</div>
                        <span class="dws-brand-subtitle">DIGITAL WARRANTY & SERVICE</span>
                    </div>
                </a>

                <div class="dws-menu-label">CUSTOMER MENU</div>

                <!-- Sidebar navigation links. -->
                <nav class="dws-nav">

                    <a asp-controller="Customer" asp-action="Index"
                       class="dws-nav-item active">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                        </svg>
                        Dashboard
                    </a>

                    <a href="#my-products" class="dws-nav-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="4" y="3" width="16" height="18" rx="2"></rect>
                            <path d="M8 7h8M8 11h8M8 15h4"></path>
                        </svg>
                        My Products
                    </a>

                    <a href="#my-warranties" class="dws-nav-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"></path>
                            <path d="m9 12 2 2 4-4"></path>
                        </svg>
                        My Warranties
                    </a>

                    <a href="#service-requests" class="dws-nav-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14.5 6.5a5 5 0 0 0-6.7 6.7L3 18l3 3 4.8-4.8a5 5 0 0 0 6.7-6.7L14 13l-3-3 3.5-3.5z"></path>
                        </svg>
                        Service Requests
                    </a>

                    <a href="#notifications" class="dws-nav-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                            <path d="M10 21h4"></path>
                        </svg>
                        Notifications
                    </a>

                </nav>

                <!-- Sidebar help information. -->
                <div class="dws-sidebar-help">
                    <strong>Need assistance?</strong>
                    <p>Your digital warranty portal keeps your product and service information in one place.</p>
                </div>
            </aside>

            <!-- Main dashboard content. -->
            <main class="dws-main">

                <!-- Dashboard header and customer account information. -->
                <header class="dws-topbar">
                    <div>
                        <div class="dws-eyebrow">CUSTOMER WORKSPACE</div>
                        <h1>Welcome back!</h1>
                        <p class="dws-topbar-description">
                            Manage your products, warranties and service requests.
                        </p>
                    </div>

                    <div class="dws-topbar-actions">

                        <!-- Displays the signed-in customer. -->
                        <div class="dws-account">
                            <div class="dws-avatar">C</div>
                            <div class="dws-account-info">
                                <strong>Customer Account</strong>
                                <small title="@customerEmail">@customerEmail</small>
                            </div>
                        </div>

                        <!-- Submits the existing AccountController Logout action. -->
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dws-logout">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M10 17l5-5-5-5"></path>
                                    <path d="M15 12H3"></path>
                                    <path d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6"></path>
                                </svg>
                                Logout
                            </button>
                        </form>

                    </div>
                </header>

                <!-- Main welcome banner. -->
                <section class="dws-hero">
                    <div class="dws-hero-content">
                        <span class="dws-hero-label">YOUR DIGITAL WARRANTY SPACE</span>

                        <h2>Your products.<br />Your protection.</h2>

                        <p>
                            Keep your product information, warranty details and service
                            updates organized in one secure place.
                        </p>

                        <div class="dws-hero-note">
                            <span class="dws-hero-check">✓</span>
                            Your warranty journey starts here.
                        </div>
                    </div>

                    <!-- Decorative warranty illustration. -->
                    <div class="dws-hero-art" aria-hidden="true">
                        <div class="dws-shield">
                            <svg viewBox="0 0 24 24" fill="none" stroke="white"
                                 stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"></path>
                                <path d="m9 12 2 2 4-4"></path>
                            </svg>
                            <strong>DIGITAL CARE</strong>
                        </div>
                        <div class="dws-floating-label">Warranty Protected</div>
                    </div>
                </section>

                <!-- Summary cards. Values remain placeholders until real dashboard data is connected. -->
                <section class="dws-stats-grid" aria-label="Dashboard summary">

                    <article class="dws-stat-card">
                        <div class="dws-stat-top">
                            <div class="dws-stat-icon dws-icon-blue">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="4" y="3" width="16" height="18" rx="2"></rect>
                                    <path d="M8 7h8M8 11h8M8 15h4"></path>
                                </svg>
                            </div>
                        </div>
                        <h3>—</h3>
                        <p>Registered Products</p>
                        <small>Your registered product list</small>
                    </article>

                    <article class="dws-stat-card">
                        <div class="dws-stat-top">
                            <div class="dws-stat-icon dws-icon-green">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"></path>
                                    <path d="m9 12 2 2 4-4"></path>
                                </svg>
                            </div>
                        </div>
                        <h3>—</h3>
                        <p>Active Warranties</p>
                        <small>Your active warranty records</small>
                    </article>

                    <article class="dws-stat-card">
                        <div class="dws-stat-top">
                            <div class="dws-stat-icon dws-icon-orange">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="9"></circle>
                                    <path d="M12 7v5l3 2"></path>
                                </svg>
                            </div>
                        </div>
                        <h3>—</h3>
                        <p>Pending Services</p>
                        <small>Requests awaiting an update</small>
                    </article>

                    <article class="dws-stat-card">
                        <div class="dws-stat-top">
                            <div class="dws-stat-icon dws-icon-purple">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                                    <path d="M10 21h4"></path>
                                </svg>
                            </div>
                        </div>
                        <h3>—</h3>
                        <p>Notifications</p>
                        <small>Your latest portal updates</small>
                    </article>

                </section>

                <!-- Quick access to the main portal modules. -->
                <section>
                    <div class="dws-section-heading">
                        <div>
                            <span>YOUR PORTAL</span>
                            <h2>Quick access</h2>
                        </div>
                        <p>Explore your customer services.</p>
                    </div>

                    <div class="dws-feature-grid">

                        <article class="dws-feature-card" id="my-products">
                            <div class="dws-stat-icon dws-icon-blue">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="4" y="3" width="16" height="18" rx="2"></rect>
                                    <path d="M8 7h8M8 11h8M8 15h4"></path>
                                </svg>
                            </div>
                            <h3>My Products</h3>
                            <p>Register your products and manage product information.</p>
                            <span class="dws-feature-status">Coming soon</span>
                        </article>

                        <article class="dws-feature-card" id="my-warranties">
                            <div class="dws-stat-icon dws-icon-green">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"></path>
                                    <path d="m9 12 2 2 4-4"></path>
                                </svg>
                            </div>
                            <h3>My Warranties</h3>
                            <p>View warranty duration, activation and expiry information.</p>
                            <span class="dws-feature-status">Coming soon</span>
                        </article>

                        <article class="dws-feature-card" id="service-requests">
                            <div class="dws-stat-icon dws-icon-orange">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14.5 6.5a5 5 0 0 0-6.7 6.7L3 18l3 3 4.8-4.8a5 5 0 0 0 6.7-6.7L14 13l-3-3 3.5-3.5z"></path>
                                </svg>
                            </div>
                            <h3>Service Requests</h3>
                            <p>Submit product service requests and follow their progress.</p>
                            <span class="dws-feature-status">Coming soon</span>
                        </article>

                        <article class="dws-feature-card" id="notifications">
                            <div class="dws-stat-icon dws-icon-purple">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                                    <path d="M10 21h4"></path>
                                </svg>
                            </div>
                            <h3>Notifications</h3>
                            <p>Stay informed about warranty and service updates.</p>
                            <span class="dws-feature-status">Coming soon</span>
                        </article>

                    </div>
                </section>

                <!-- Recent activity section. -->
                <section class="dws-activity-panel">
                    <div class="dws-activity-header">
                        <h2>Recent Activity</h2>
                        <span class="dws-activity-badge">Activity overview</span>
                    </div>

                    <!-- Empty state shown until customer activity is connected. -->
                    <div class="dws-empty-state">
                        <div class="dws-empty-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                                <path d="M16 2v4M8 2v4M3 10h18M8 14h3"></path>
                            </svg>
                        </div>
                        <h3>No recent activity</h3>
                        <p>
                            Your product registrations, warranty updates and service
                            request activities will appear here.
                        </p>
                    </div>
                </section>

                <!-- Customer dashboard footer. -->
                <footer class="dws-dashboard-footer">
                    <span>© @DateTime.Now.Year Digital Warranty & Service Portal</span>
                    <span>Customer Workspace</span>
                </footer>

            </main>
        </div>
    </div>

</body>
</html>
