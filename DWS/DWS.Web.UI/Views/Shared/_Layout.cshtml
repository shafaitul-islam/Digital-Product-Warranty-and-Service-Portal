
<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Defines the character encoding for the webpage. -->
    <meta charset="utf-8" />

    <!-- Makes the application responsive on different screen sizes. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Sets the browser tab title dynamically from the current MVC view. -->
    <title>@ViewData["Title"] - DWS.Web.UI</title>

    <!-- Provides import map support for browser modules. -->
    <script type="importmap"></script>

    <!-- Loads Bootstrap CSS for responsive layouts and UI components. -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Loads the application's default styles. -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Loads styles generated by the ASP.NET Core project. -->
    <link rel="stylesheet" href="~/DWS.Web.UI.styles.css" asp-append-version="true" />

    <!-- Loads global theme styles after other stylesheets. -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>

<body>

    <!-- Main application header containing the navigation bar. -->
    <header>

        <!-- Provides the shared navigation bar for application pages. -->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3 dws-global-navbar">

            <div class="container-fluid">

                <!-- Application brand link navigates to the Home page. -->
                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Digital Warranty & Service Portal
                </a>

                <!-- Creates the responsive navigation menu button. -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Contains navigation links and the global theme switcher. -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Main application navigation links. -->
                    <ul class="navbar-nav flex-grow-1">

                        <!-- Navigates to the Home page. -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <!-- Navigates to the Privacy page. -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>

                    <!-- Provides the shared Light and Dark theme toggle button. -->
                    <button type="button"
                            class="btn btn-outline-primary dws-theme-toggle"
                            data-theme-toggle
                            aria-label="Switch to dark mode">

                        <!-- Displays the current theme action icon. -->
                        <span data-theme-icon>🌙</span>

                        <!-- Displays the theme switching label. -->
                        <span data-theme-label>Dark Mode</span>

                    </button>

                </div>
            </div>
        </nav>
    </header>

    <!-- Main page container. -->
    <div class="container">

        <!-- Displays the content of the current MVC view. -->
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    </div>

    <!-- Shared application footer. -->
    <footer class="border-top footer text-muted dws-global-footer">

        <div class="container">

            <!-- Displays the application copyright information. -->
            &copy; @DateTime.Now.Year - Digital Warranty & Service Portal -

            <!-- Provides a link to the Privacy page. -->
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>

        </div>
    </footer>

    <!-- Loads jQuery for scripts that depend on it. -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Loads Bootstrap JavaScript components. -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Loads the application's general JavaScript functionality. -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Loads the centralized Light and Dark theme manager. -->
    <script src="~/js/theme.js" asp-append-version="true"></script>

    <!-- Allows individual MVC views to load additional scripts. -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
